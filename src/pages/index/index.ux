<template>
  <div class="page">
    <div if="{{ ready }}" class="app-shell">
      <div class="topbar">
        <text class="brand">练了么</text>
        <text if="{{ screen === 'workout' }}" class="top-progress">{{ connectionLabel }} · {{ setProgress }}</text>
      </div>

      <div if="{{ screen === 'workout' }}" class="screen workout-screen">
        <div if="{{ !editing }}" class="workout-view">
          <div class="workout-main">
            <text class="workout-context">{{ workoutProgress }}</text>
            <div class="exercise-title-card">
              <text class="exercise-name">{{ currentExerciseName }}</text>
            </div>

            <div class="set-card">
              <div class="set-card-topline">
                <text class="set-label">{{ currentSetLabel }}</text>
                <text class="rest-hint">休息 {{ currentRestSeconds }} 秒</text>
              </div>
              <div class="prescription-row">
                <text if="{{ currentWeight === null }}" class="prescription-bodyweight">自重</text>
                <text else class="prescription-number">{{ currentWeight }}</text>
                <text if="{{ currentWeight !== null }}" class="prescription-unit">kg</text>
                <text class="prescription-separator">×</text>
                <text class="prescription-number">{{ currentReps }}</text>
                <text class="prescription-unit">次</text>
              </div>
            </div>
          </div>

          <div class="workout-action-zone">
            <div class="action-row workout-actions">
              <div class="half-action workout-half-action dark-half-action" onclick="toggleEdit">
                <text class="half-action-text dark-half-action-text">调整本组</text>
              </div>
              <div class="half-action workout-half-action light-half-action" onclick="completeSet">
                <text class="half-action-text light-half-action-text">完成本组</text>
              </div>
            </div>

            <div class="workout-meta-row">
              <text if="{{ canUndo }}" class="undo-link" onclick="undoLastSet">撤销上一组</text>
              <text class="next-hint">下一组：{{ nextHint }}</text>
            </div>
          </div>
        </div>

        <div else class="adjust-screen">
          <text class="adjust-exercise-name">{{ currentExerciseName }}</text>
          <text class="adjust-prescription">{{ prescription }}</text>

          <div class="adjust-section">
            <div class="adjust-heading-row">
              <text class="adjust-heading">重量</text>
              <text class="adjust-current">{{ weightText }}</text>
            </div>
            <div class="adjust-button-row">
              <div class="adjust-step-button" onclick="decreaseWeight">
                <text class="adjust-step-text">−2.5 kg</text>
              </div>
              <div class="adjust-step-button" onclick="increaseWeight">
                <text class="adjust-step-text">+2.5 kg</text>
              </div>
            </div>
          </div>

          <div class="adjust-section adjust-reps-section">
            <div class="adjust-heading-row">
              <text class="adjust-heading">次数</text>
              <text class="adjust-current">{{ repsText }}</text>
            </div>
            <div class="adjust-button-row">
              <div class="adjust-step-button" onclick="decreaseReps">
                <text class="adjust-step-text">−1 次</text>
              </div>
              <div class="adjust-step-button" onclick="increaseReps">
                <text class="adjust-step-text">+1 次</text>
              </div>
            </div>
          </div>

          <div class="action-row adjust-actions">
            <div class="half-action adjust-half-action dark-half-action" onclick="cancelEdit">
              <text class="half-action-text dark-half-action-text">取消</text>
            </div>
            <div class="half-action adjust-half-action light-half-action" onclick="confirmEdit">
              <text class="half-action-text light-half-action-text">完成调整</text>
            </div>
          </div>
        </div>
      </div>

      <div elif="{{ screen === 'rir' }}" class="screen rir-screen">
        <text class="rir-exercise-name">{{ currentExerciseName }}</text>
        <text class="rir-title">RIR</text>
        <text class="rir-hint">剩余次数</text>

        <div class="rir-grid">
          <div class="rir-row">
            <div class="rir-button" onclick="selectRir0"><text class="rir-button-text">0</text></div>
            <div class="rir-button" onclick="selectRir1"><text class="rir-button-text">1</text></div>
          </div>
          <div class="rir-row">
            <div class="rir-button" onclick="selectRir2"><text class="rir-button-text">2</text></div>
            <div class="rir-button" onclick="selectRir3"><text class="rir-button-text">3</text></div>
          </div>
          <div class="rir-row">
            <div class="rir-button" onclick="selectRir4"><text class="rir-button-text">4</text></div>
            <div class="rir-button" onclick="selectRir5"><text class="rir-button-text">5</text></div>
          </div>
        </div>
      </div>

      <div elif="{{ screen === 'rest' }}" class="screen rest-screen">
        <text class="rest-title">休息</text>
        <text class="countdown">{{ restRemaining }}</text>
        <text class="seconds">秒</text>

        <div class="rest-adjust-row">
          <div class="rest-adjust-button" onclick="decreaseRest"><text class="rest-adjust-text">−15 秒</text></div>
          <div class="rest-adjust-button" onclick="increaseRest"><text class="rest-adjust-text">+15 秒</text></div>
        </div>

        <div class="next-card">
          <text class="next-eyebrow">下一组</text>
          <text class="next-name">{{ nextExerciseName }}</text>
          <text class="next-meta">{{ nextSetLabel }} · {{ nextPrescription }}</text>
        </div>

        <div class="action-row rest-actions">
          <div class="half-action rest-half-action dark-half-action" onclick="undoLastSet">
            <text class="half-action-text dark-half-action-text">撤销上一组</text>
          </div>
          <div class="half-action rest-half-action light-half-action" onclick="skipRest">
            <text class="half-action-text light-half-action-text">跳过休息</text>
          </div>
        </div>
      </div>

      <div else class="screen complete-screen">
        <div class="done-mark-box"><text class="done-mark">✓</text></div>
        <text class="done-title">训练完成</text>
        <text class="done-summary">共完成 {{ completedSets }} 组</text>

        <div class="done-status-block">
          <text class="done-status-title">{{ doneStatusTitle }}</text>
          <text if="{{ doneStatusDetail }}" class="done-status-detail">{{ doneStatusDetail }}</text>
        </div>

        <div class="action-row complete-actions">
          <div if="{{ canUndo && !completionConfirmed }}" class="half-action complete-half-action dark-half-action" onclick="undoLastSet">
            <text class="half-action-text dark-half-action-text">撤销最后一组</text>
          </div>
          <div else class="half-spacer"></div>
          <div class="half-action complete-half-action light-half-action" onclick="confirmWorkoutComplete">
            <text class="half-action-text light-half-action-text">{{ completionConfirmed ? '退出' : '完成' }}</text>
          </div>
        </div>
      </div>
    </div>

    <div else class="restore-screen">
      <text class="restore-brand">练了么</text>
      <text class="restore-text">正在恢复训练状态</text>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import interconnect from '@system.interconnect'
import app from '@system.app'
import protocol from '../../common/workout-protocol.js'
import runtime from '../../common/workout-runtime.js'
import storeFactory from '../../common/workout-store.js'
import transportFactory from '../../common/workout-transport.js'

var PLAN_KEY = 'lianleme.workout.plan.v1'
var STATE_KEY = 'lianleme.workout.state.v3'
var STATE_VERSION = 3
var APP_VERSION = '0.4.5'
var PROGRESS_RETRY_MS = 2500

var WORKOUT = runtime.demoWorkout()
var STORE = storeFactory.create(storage, {
  planKey: PLAN_KEY,
  stateKey: STATE_KEY
})
var TRANSPORT = null

export default {
  private: {
    ready: false,
    screen: 'workout',
    editing: false,
    editOriginalWeight: null,
    editOriginalReps: 0,
    exerciseIndex: 0,
    setIndex: 0,
    pendingExerciseIndex: 0,
    pendingSetIndex: 0,
    completedSets: 0,
    totalSets: 0,
    completedRecords: [],
    canUndo: false,
    currentExerciseName: '',
    currentSetLabel: '',
    currentRestSeconds: 0,
    currentWeight: null,
    currentReps: 0,
    weightText: '',
    repsText: '',
    prescription: '',
    workoutProgress: '',
    setProgress: '',
    nextHint: '',
    restRemaining: 0,
    restEndAt: 0,
    nextExerciseName: '',
    nextSetLabel: '',
    nextPrescription: '',
    restTimer: null,
    progressRetryTimer: null,
    connectionReady: false,
    connectionLabel: '离线',
    completionConfirmed: false,
    completionSynced: false,
    syncPending: false,
    progressUpdatedAt: 0,
    lastAckUpdatedAt: 0,
    pendingPlan: null,
    pendingPlanReplyTo: '',
    doneStatusTitle: '已保存在手环',
    doneStatusDetail: '连接后自动同步'
  },

  onInit() {
    this.restorePlan()
  },

  onShow() {
    if (!this.ready) {
      return
    }
    this.resumeFromLifecycle()
    this.sendHelloAndProgress()
  },

  onHide() {
    if (!this.ready) {
      return
    }
    if (this.editing) {
      this.cancelEdit(true)
    }
    this.stopRestTimer()
    this.stopProgressRetry()
    this.saveState()
  },

  onDestroy() {
    if (!this.ready) {
      return
    }
    if (this.editing) {
      this.cancelEdit(true)
    }
    this.stopRestTimer()
    this.stopProgressRetry()
    this.saveState()
  },

  restorePlan() {
    var that = this
    STORE.loadPlan(runtime.demoWorkout(), protocol.normalizePlan, function(plan) {
      WORKOUT = plan
      that.totalSets = runtime.countSets(WORKOUT)
      that.restoreState()
    })
  },

  restoreState() {
    var that = this
    STORE.loadState(function(state) {
      var restored = state ? that.applyStoredState(state) : false
      if (!restored) {
        that.resetWorkoutState()
      }
      that.ready = true
      that.resumeFromLifecycle()
      that.setupInterconnect()
    })
  },

  applyStoredState(state) {
    if (!state || state.stateVersion !== STATE_VERSION) {
      return false
    }
    if (!WORKOUT.id && !WORKOUT.revision && state.screen === 'complete' && state.completionConfirmed) {
      return false
    }
    if (String(state.workoutId || '') !== String(WORKOUT.id || '') ||
        String(state.revision || '') !== String(WORKOUT.revision || '')) {
      return false
    }
    if (!runtime.validSetIndex(WORKOUT, state.exerciseIndex, state.setIndex)) {
      return false
    }

    this.stopRestTimer()
    this.screen = state.screen === 'rest' || state.screen === 'rir' || state.screen === 'complete' ? state.screen : 'workout'
    this.exerciseIndex = state.exerciseIndex
    this.setIndex = state.setIndex
    this.pendingExerciseIndex = runtime.validSetIndex(WORKOUT, state.pendingExerciseIndex, state.pendingSetIndex)
      ? state.pendingExerciseIndex
      : state.exerciseIndex
    this.pendingSetIndex = runtime.validSetIndex(WORKOUT, state.pendingExerciseIndex, state.pendingSetIndex)
      ? state.pendingSetIndex
      : state.setIndex
    this.completedRecords = Array.isArray(state.completedRecords) ? state.completedRecords : []
    this.completedSets = this.completedRecords.length
    this.canUndo = this.completedSets > 0
    this.restEndAt = typeof state.restEndAt === 'number' ? state.restEndAt : 0
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.completionConfirmed = !!state.completionConfirmed
    this.completionSynced = !!state.completionSynced
    this.progressUpdatedAt = Number(state.progressUpdatedAt || state.updatedAt) || runtime.nowMs()
    this.lastAckUpdatedAt = Number(state.lastAckUpdatedAt) || 0
    this.syncPending = typeof state.syncPending === 'boolean'
      ? state.syncPending
      : (this.completedRecords.length > 0 && !this.completionSynced)

    var plannedSet = WORKOUT.exercises[this.exerciseIndex].sets[this.setIndex]
    this.currentWeight = state.currentWeight === null || typeof state.currentWeight === 'number'
      ? state.currentWeight
      : plannedSet.weight
    this.currentReps = typeof state.currentReps === 'number' ? state.currentReps : plannedSet.reps
    this.refreshCurrentDisplay()
    this.refreshDoneStatus()

    if (this.screen === 'rest') {
      if (!runtime.validSetIndex(WORKOUT, this.pendingExerciseIndex, this.pendingSetIndex) || this.restEndAt <= 0) {
        return false
      }
      this.refreshRestPreview()
      this.syncRestRemaining()
    }

    return true
  },

  currentStateSnapshot() {
    return runtime.stateSnapshot(WORKOUT, this, STATE_VERSION)
  },

  markProgressDirty() {
    this.progressUpdatedAt = runtime.nowMs()
    this.syncPending = true
    if (this.screen === 'complete') {
      this.completionSynced = false
    }
  },

  saveState(onSaved) {
    var state = this.currentStateSnapshot()
    STORE.saveState(state, onSaved)
    return state
  },

  persistPlan(onSaved) {
    STORE.savePlan(WORKOUT, onSaved)
  },

  resetWorkoutState() {
    this.stopRestTimer()
    this.stopProgressRetry()
    this.screen = 'workout'
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.exerciseIndex = 0
    this.setIndex = 0
    this.pendingExerciseIndex = 0
    this.pendingSetIndex = 0
    this.completedRecords = []
    this.completedSets = 0
    this.totalSets = runtime.countSets(WORKOUT)
    this.canUndo = false
    this.restRemaining = 0
    this.restEndAt = 0
    this.completionConfirmed = false
    this.completionSynced = false
    this.syncPending = false
    this.progressUpdatedAt = runtime.nowMs()
    this.lastAckUpdatedAt = 0
    this.refreshDoneStatus()
    this.loadCurrentSet()
  },

  setupInterconnect() {
    var that = this
    TRANSPORT = transportFactory.create(interconnect, protocol, {
      onMessage: function(raw) {
        that.handleIncomingMessage(raw)
      },
      onConnectionChange: function(ready) {
        that.connectionReady = ready
        if (!ready) {
          that.stopProgressRetry()
        }
        that.refreshConnectionLabels()
      },
      onReady: function() {
        that.connectionReady = true
        that.refreshConnectionLabels()
        that.sendHelloAndProgress()
      }
    })
    TRANSPORT.start()
  },

  refreshConnectionLabels() {
    this.connectionLabel = this.connectionReady ? '手机已连' : '离线'
    this.refreshDoneStatus()
  },

  refreshDoneStatus() {
    if (this.completionSynced) {
      this.doneStatusTitle = '已同步到手机'
      this.doneStatusDetail = ''
      return
    }
    if (this.connectionReady) {
      this.doneStatusTitle = '正在同步到手机'
      this.doneStatusDetail = '记录仍保存在手环'
      return
    }
    this.doneStatusTitle = '已保存在手环'
    this.doneStatusDetail = '连接后自动同步'
  },

  sendEnvelope(type, payload) {
    return TRANSPORT ? TRANSPORT.send(type, payload) : false
  },

  sendHelloAndProgress() {
    if (!this.connectionReady) {
      return
    }
    this.sendEnvelope('hello', {
      appVersion: APP_VERSION,
      planId: String(WORKOUT.planId || ''),
      workoutId: String(WORKOUT.id || ''),
      revision: String(WORKOUT.revision || '')
    })
    this.publishProgress()
  },

  stopProgressRetry() {
    if (this.progressRetryTimer !== null) {
      clearTimeout(this.progressRetryTimer)
      this.progressRetryTimer = null
    }
  },

  scheduleProgressRetry() {
    this.stopProgressRetry()
    if (!this.connectionReady || !this.syncPending || !WORKOUT.id || !WORKOUT.revision) {
      return
    }
    var that = this
    this.progressRetryTimer = setTimeout(function() {
      that.progressRetryTimer = null
      if (!that.connectionReady || !that.syncPending) {
        return
      }
      that.publishProgress()
    }, PROGRESS_RETRY_MS)
  },

  publishProgress() {
    if (!WORKOUT.id || !WORKOUT.revision) {
      return false
    }
    var state = this.currentStateSnapshot()
    var sent = this.sendEnvelope('progress', protocol.progressPayload(WORKOUT, state))
    if (sent && this.syncPending) {
      this.scheduleProgressRetry()
    }
    return sent
  },

  handleIncomingMessage(raw) {
    var message = protocol.decode(raw)
    if (!message) {
      return
    }
    if (message.type === 'plan') {
      this.applyIncomingPlan(message.payload, message.id)
      return
    }
    if (message.type === 'progress') {
      this.applyIncomingProgress(message.payload)
      return
    }
    if (message.type === 'progress-ack') {
      this.applyProgressAck(message.payload)
    }
  },

  applyProgressAck(payload) {
    payload = payload || {}
    if (String(payload.workoutId || '') !== String(WORKOUT.id || '') ||
        String(payload.revision || '') !== String(WORKOUT.revision || '') ||
        String(payload.planId || '') !== String(WORKOUT.planId || '')) {
      return
    }
    var ackAt = Number(payload.updatedAt) || 0
    if (ackAt > 0 && ackAt < Number(this.progressUpdatedAt || 0)) {
      return
    }
    this.syncPending = false
    this.stopProgressRetry()
    this.lastAckUpdatedAt = ackAt || runtime.nowMs()
    if (this.screen === 'complete') {
      this.completionSynced = true
    }
    this.refreshDoneStatus()
    var that = this
    this.saveState(function(saved) {
      if (saved) {
        that.tryApplyPendingPlan()
      }
    })
  },

  applyIncomingProgress(payload) {
    var progress = protocol.normalizeProgress(payload)
    if (!progress || !protocol.progressMatchesPlan(progress, WORKOUT)) {
      return
    }
    if (this.syncPending) {
      this.publishProgress()
      return
    }

    var normalized = runtime.normalizeCompletedRecords(WORKOUT, progress.completedRecords)
    var records = normalized.records
    var completed = normalized.completed
    var previousCompleted = this.completedRecords.length
    var previousScreen = this.screen

    this.stopRestTimer()
    this.stopProgressRetry()
    this.completedRecords = records
    this.completedSets = records.length
    this.canUndo = this.completedSets > 0
    this.restEndAt = 0
    this.restRemaining = 0
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.completionConfirmed = false
    this.progressUpdatedAt = progress.updatedAt || runtime.nowMs()
    this.lastAckUpdatedAt = this.progressUpdatedAt
    this.syncPending = false

    var next = runtime.firstIncompleteIndices(WORKOUT, completed)
    if (progress.status === 'complete' || !next) {
      this.screen = 'complete'
      this.completionSynced = true
      var lastExerciseIndex = Math.max(0, WORKOUT.exercises.length - 1)
      var lastSetIndex = Math.max(0, WORKOUT.exercises[lastExerciseIndex].sets.length - 1)
      this.exerciseIndex = lastExerciseIndex
      this.setIndex = lastSetIndex
      this.pendingExerciseIndex = lastExerciseIndex
      this.pendingSetIndex = lastSetIndex
      this.loadCurrentSet()
    } else {
      this.screen = 'workout'
      this.completionSynced = false
      this.exerciseIndex = next.exerciseIndex
      this.setIndex = next.setIndex
      this.pendingExerciseIndex = next.exerciseIndex
      this.pendingSetIndex = next.setIndex
      this.loadCurrentSet()
    }

    this.refreshDoneStatus()
    if (this.completedRecords.length !== previousCompleted || this.screen !== previousScreen) {
      vibrator.vibrate({ mode: 'short' })
    }
    var that = this
    this.saveState(function(saved) {
      if (!saved) {
        return
      }
      that.sendEnvelope('progress-ack', {
        workoutId: String(WORKOUT.id || ''),
        revision: String(WORKOUT.revision || ''),
        planId: String(WORKOUT.planId || ''),
        updatedAt: that.progressUpdatedAt
      })
      that.tryApplyPendingPlan()
    })
  },

  hasActiveLocalSession() {
    return (this.completedRecords.length > 0 || this.screen === 'rir') && this.screen !== 'complete'
  },

  sendPlanAck(plan, status, replyTo, reason) {
    this.sendEnvelope('ack', {
      replyTo: String(replyTo || ''),
      workoutId: String(plan && plan.id || ''),
      revision: String(plan && plan.revision || ''),
      status: status || 'accepted',
      reason: reason || '',
      currentWorkoutId: String(WORKOUT.id || ''),
      currentRevision: String(WORKOUT.revision || '')
    })
  },

  installIncomingPlan(plan, replyTo) {
    this.pendingPlan = null
    this.pendingPlanReplyTo = ''
    WORKOUT = plan
    this.totalSets = runtime.countSets(WORKOUT)
    this.resetWorkoutState()
    var that = this
    this.persistPlan(function(planSaved) {
      if (!planSaved) {
        that.pendingPlan = plan
        that.pendingPlanReplyTo = String(replyTo || '')
        return
      }
      that.saveState(function(stateSaved) {
        if (!stateSaved) {
          that.pendingPlan = plan
          that.pendingPlanReplyTo = String(replyTo || '')
          return
        }
        vibrator.vibrate({ mode: 'short' })
        that.sendPlanAck(plan, 'accepted', replyTo, '')
      })
    })
  },

  tryApplyPendingPlan() {
    if (!this.pendingPlan) {
      return false
    }
    var unsyncedLocalSession = this.syncPending && WORKOUT.id && WORKOUT.revision
    if (this.hasActiveLocalSession() || unsyncedLocalSession) {
      return false
    }
    var plan = this.pendingPlan
    var replyTo = this.pendingPlanReplyTo
    this.installIncomingPlan(plan, replyTo)
    return true
  },

  applyIncomingPlan(payload, replyTo) {
    var plan = protocol.normalizePlan(payload)
    if (!plan || !plan.id || !plan.revision) {
      return
    }

    var same = protocol.samePlan(WORKOUT, plan)
    if (same) {
      if (this.pendingPlan && protocol.samePlan(this.pendingPlan, plan)) {
        this.installIncomingPlan(plan, replyTo)
        return
      }
      this.sendPlanAck(plan, 'accepted', replyTo, '')
      if (this.syncPending) {
        this.publishProgress()
      }
      return
    }

    var activeLocalSession = this.hasActiveLocalSession()
    var unsyncedLocalSession = this.syncPending && WORKOUT.id && WORKOUT.revision
    if (activeLocalSession || unsyncedLocalSession) {
      this.pendingPlan = plan
      this.pendingPlanReplyTo = String(replyTo || '')
      this.sendPlanAck(plan, 'deferred', replyTo, activeLocalSession ? 'active-session' : 'sync-pending')
      this.publishProgress()
      return
    }

    this.installIncomingPlan(plan, replyTo)
  },

  resumeFromLifecycle() {
    if (this.screen !== 'rest') {
      return
    }
    this.syncRestRemaining()
    if (this.restRemaining <= 0) {
      this.finishRest(true)
      return
    }
    this.startRestTimer()
  },

  loadCurrentSet(weightOverride, repsOverride) {
    var set = WORKOUT.exercises[this.exerciseIndex].sets[this.setIndex]
    this.currentWeight = weightOverride === null || typeof weightOverride === 'number' ? weightOverride : set.weight
    this.currentReps = typeof repsOverride === 'number' ? repsOverride : set.reps
    this.refreshCurrentDisplay()
  },

  refreshCurrentDisplay() {
    var exercise = WORKOUT.exercises[this.exerciseIndex]

    this.currentExerciseName = exercise.name
    this.currentSetLabel = '第 ' + (this.setIndex + 1) + ' / ' + exercise.sets.length + ' 组'
    this.currentRestSeconds = exercise.restSeconds
    this.workoutProgress = WORKOUT.name + ' · 动作 ' + (this.exerciseIndex + 1) + ' / ' + WORKOUT.exercises.length
    this.setProgress = this.completedSets + ' / ' + this.totalSets
    this.updatePrescription()
    this.updateNextHint()
  },

  updatePrescription() {
    this.weightText = runtime.numeric(this.currentWeight) === null ? '自重' : runtime.formatWeight(this.currentWeight) + ' kg'
    this.repsText = this.currentReps + ' 次'
    this.prescription = runtime.formatPrescription(this.currentWeight, this.currentReps)
  },

  updateNextHint() {
    var next = this.getNextIndices()
    if (!next) {
      this.nextHint = '完成训练'
      return
    }

    if (next.exerciseIndex === this.exerciseIndex) {
      this.nextHint = '第 ' + (next.setIndex + 1) + ' 组'
    } else {
      this.nextHint = WORKOUT.exercises[next.exerciseIndex].name
    }
  },

  getNextIndices() {
    return runtime.getNextIndices(WORKOUT, this.exerciseIndex, this.setIndex)
  },

  toggleEdit() {
    if (this.editing || this.screen !== 'workout') {
      return
    }
    this.editOriginalWeight = this.currentWeight
    this.editOriginalReps = this.currentReps
    this.editing = true
    vibrator.vibrate({ mode: 'short' })
  },

  cancelEdit(silent) {
    if (!this.editing) {
      return
    }
    this.currentWeight = this.editOriginalWeight
    this.currentReps = this.editOriginalReps
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.updatePrescription()
    if (silent === true) {
      return
    }
    this.saveState()
    vibrator.vibrate({ mode: 'short' })
  },

  confirmEdit() {
    if (!this.editing) {
      return
    }
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.saveState()
    vibrator.vibrate({ mode: 'short' })
  },

  decreaseWeight() {
    if (runtime.numeric(this.currentWeight) === null || this.currentWeight <= 2.5) {
      return
    }
    this.currentWeight = this.currentWeight - 2.5
    this.updatePrescription()
    vibrator.vibrate({ mode: 'short' })
  },

  increaseWeight() {
    if (runtime.numeric(this.currentWeight) === null) {
      return
    }
    this.currentWeight = this.currentWeight + 2.5
    this.updatePrescription()
    vibrator.vibrate({ mode: 'short' })
  },

  decreaseReps() {
    if (this.currentReps <= 1) {
      return
    }
    this.currentReps = this.currentReps - 1
    this.updatePrescription()
    vibrator.vibrate({ mode: 'short' })
  },

  increaseReps() {
    this.currentReps = this.currentReps + 1
    this.updatePrescription()
    vibrator.vibrate({ mode: 'short' })
  },

  completeSet() {
    if (this.screen !== 'workout') {
      return
    }

    var exercise = WORKOUT.exercises[this.exerciseIndex]
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0

    if (!exercise.warmup) {
      this.screen = 'rir'
      this.saveState()
      vibrator.vibrate({ mode: 'short' })
      return
    }

    this.finishCurrentSet(null)
  },

  selectRir0() {
    this.finishCurrentSet(0)
  },

  selectRir1() {
    this.finishCurrentSet(1)
  },

  selectRir2() {
    this.finishCurrentSet(2)
  },

  selectRir3() {
    this.finishCurrentSet(3)
  },

  selectRir4() {
    this.finishCurrentSet(4)
  },

  selectRir5() {
    this.finishCurrentSet(5)
  },

  finishCurrentSet(actualRir) {
    if (this.screen !== 'workout' && this.screen !== 'rir') {
      return
    }

    var next = this.getNextIndices()
    var record = runtime.createCompletionRecord(WORKOUT, this, actualRir)
    if (!record) {
      return
    }

    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.completedRecords.push(record)
    this.completedRecords = this.completedRecords.slice(0)
    this.completedSets = this.completedRecords.length
    this.canUndo = true
    this.setProgress = this.completedSets + ' / ' + this.totalSets
    this.markProgressDirty()
    vibrator.vibrate({ mode: 'short' })

    if (!next) {
      this.finishWorkout()
      return
    }

    this.pendingExerciseIndex = next.exerciseIndex
    this.pendingSetIndex = next.setIndex
    this.prepareRestScreen()
    this.screen = 'rest'
    var that = this
    this.saveState(function(saved) {
      if (saved) {
        that.publishProgress()
      }
    })
    this.startRestTimer()
  },

  prepareRestScreen() {
    var currentExercise = WORKOUT.exercises[this.exerciseIndex]
    this.restEndAt = runtime.nowMs() + currentExercise.restSeconds * 1000
    this.refreshRestPreview()
    this.syncRestRemaining()
  },

  refreshRestPreview() {
    var nextExercise = WORKOUT.exercises[this.pendingExerciseIndex]
    var nextSet = nextExercise.sets[this.pendingSetIndex]

    this.nextExerciseName = nextExercise.name
    this.nextSetLabel = '第 ' + (this.pendingSetIndex + 1) + ' / ' + nextExercise.sets.length + ' 组'
    this.nextPrescription = runtime.formatPrescription(nextSet.weight, nextSet.reps)
  },

  syncRestRemaining() {
    var remainingMs = this.restEndAt - runtime.nowMs()
    if (remainingMs <= 0) {
      this.restRemaining = 0
      return
    }
    this.restRemaining = Math.ceil(remainingMs / 1000)
  },

  startRestTimer() {
    this.stopRestTimer()
    this.syncRestRemaining()
    if (this.restRemaining <= 0) {
      this.finishRest(true)
      return
    }

    var that = this
    this.restTimer = setInterval(function() {
      that.syncRestRemaining()
      if (that.restRemaining <= 0) {
        that.finishRest(true)
      }
    }, 1000)
  },

  stopRestTimer() {
    if (this.restTimer !== null) {
      clearInterval(this.restTimer)
      this.restTimer = null
    }
  },

  decreaseRest() {
    this.adjustRest(-15)
  },

  increaseRest() {
    this.adjustRest(15)
  },

  adjustRest(deltaSeconds) {
    if (this.screen !== 'rest') {
      return
    }

    var minimumEnd = runtime.nowMs() + 5000
    var nextEnd = this.restEndAt + deltaSeconds * 1000
    this.restEndAt = nextEnd < minimumEnd ? minimumEnd : nextEnd
    this.syncRestRemaining()
    this.saveState()
  },

  skipRest() {
    if (this.screen !== 'rest') {
      return
    }
    this.finishRest(false)
  },

  finishRest(naturalEnd) {
    if (this.screen !== 'rest') {
      return
    }

    this.stopRestTimer()
    if (naturalEnd) {
      vibrator.vibrate({ mode: 'long' })
    }

    this.exerciseIndex = this.pendingExerciseIndex
    this.setIndex = this.pendingSetIndex
    this.restEndAt = 0
    this.restRemaining = 0
    this.screen = 'workout'
    this.loadCurrentSet()
    this.saveState()
  },

  undoLastSet() {
    if (!this.completedRecords.length) {
      return
    }

    this.stopRestTimer()
    var record = this.completedRecords[this.completedRecords.length - 1]
    this.completedRecords = this.completedRecords.slice(0, this.completedRecords.length - 1)
    this.completedSets = this.completedRecords.length
    this.canUndo = this.completedSets > 0
    this.screen = 'workout'
    this.editing = false
    this.editOriginalWeight = null
    this.editOriginalReps = 0
    this.completionConfirmed = false
    this.completionSynced = false
    this.exerciseIndex = record.exerciseIndex
    this.setIndex = record.setIndex
    this.pendingExerciseIndex = record.exerciseIndex
    this.pendingSetIndex = record.setIndex
    this.restEndAt = 0
    this.restRemaining = 0
    this.loadCurrentSet(record.actualWeight, record.actualReps)
    this.markProgressDirty()
    this.refreshDoneStatus()
    vibrator.vibrate({ mode: 'short' })
    var that = this
    this.saveState(function(saved) {
      if (saved) {
        that.publishProgress()
      }
    })
  },

  finishWorkout() {
    this.stopRestTimer()
    this.restEndAt = 0
    this.restRemaining = 0
    this.completionConfirmed = false
    this.completionSynced = false
    this.screen = 'complete'
    this.refreshDoneStatus()
    var that = this
    this.saveState(function(saved) {
      if (saved) {
        that.publishProgress()
      }
    })
    vibrator.vibrate({ mode: 'long' })
  },

  terminateAfterSave() {
    var that = this
    setTimeout(function() {
      if (that.screen !== 'complete') {
        return
      }
      try {
        app.terminate()
      } catch (error) {
        console.log('Vela app terminate failed: ' + error)
      }
    }, 120)
  },

  confirmWorkoutComplete() {
    if (this.screen !== 'complete') {
      return
    }
    if (!this.completionConfirmed) {
      this.completionConfirmed = true
      var that = this
      this.saveState(function(saved) {
        if (!saved) {
          return
        }
        if (!that.completionSynced) {
          that.publishProgress()
        }
        vibrator.vibrate({ mode: 'short' })
        that.terminateAfterSave()
      })
      return
    }
    this.terminateAfterSave()
  }
}
</script>

<style>
@import '../../common/workout.css';
</style>