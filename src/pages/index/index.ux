  margin-top: -5px;
  font-size: 12px;
  color: #68758a;
}

.rest-adjust-row {
  width: 300px;
  height: 48px;
  margin-top: 8px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.rest-adjust-button {
  width: 144px;
  height: 48px;
  border-radius: 16px;
  border-width: 1px;
  border-color: #1b2331;
  justify-content: center;
  align-items: center;
  background-color: #10151d;
}

.rest-adjust-text {
  font-size: 15px;
  font-weight: bold;
  color: #98a4b7;
}

.next-card {
  width: 300px;
