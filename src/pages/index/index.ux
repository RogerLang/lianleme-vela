<template>
  <div class="page">
    <div if="{{ ready && hasPlan }}" class="app-shell">
      <div class="topbar">
        <text class="brand">练了么</text>
        <text if="{{ screen === 'workout' }}" class="top-progress">{{ connectionLabel }} · {{ setProgress }}</text>
      </div>

      <div if="{{ screen === 'workout' }}" class="screen workout-screen">
        <div class="workout-main">
          <text class="workout-context">{{ workoutProgress }}</text>
          <text class="exercise-name">{{ currentExerciseName }}</text>

          <div class="set-card">
            <text class="set-label">{{ currentSetLabel }}</text>
            <text class="prescription">{{ prescription }}</text>
            <text class="rest-hint">休息 {{ currentRestSeconds }} 秒</text>
          </div>

          <div if="{{ editing }}" class="adjust-panel">
            <div class="adjust-row">
              <div class="step-button" onclick="decreaseWeight"><text class="step-text">−2.5</text></div>
              <text class="adjust-value">{{ weightText }}</text>
              <div class="step-button" onclick="increaseWeight"><text class="step-text">+2.5</text></div>
            </div>
            <div class="adjust-row second-adjust-row">
              <div class="step-button" onclick="decreaseReps"><text class="step-text">−1</text></div>
              <text class="adjust-value">{{ repsText }}</text>
              <div class="step-button" onclick="increaseReps"><text class="step-text">+1</text></div>
            </div>
          </div>
        </div>

        <div class="workout-action-zone">
          <div class="action-row workout-actions">
            <div class="half-action workout-half-action dark-half-action" onclick="toggleEdit">
              <text class="half-action-text dark-half-action-text">{{ editToggleText }}</text>
            </div>
            <div class="half-action workout-half-action light-half-action" onclick="completeSet">
              <text class="half-action-text light-half-action-text">完成本组</text>
            </div>
          </div>

          <div if="{{ !editing }}" class="workout-meta-row">
            <text if="{{ canUndo }}" class="undo-link" onclick="undoLastSet">撤销上一组</text>
            <text class="next-hint">下一组：{{ nextHint }}</text>
          </div>
        </div>
      </div>

      <div elif="{{ screen === 'rest' }}" class="screen rest-screen">
        <text class="rest-title">休息</text>
        <text class="countdown">{{ restRemaining }}</text>
        <text class="seconds">秒</text>

        <div class="rest-adjust-row">
          <div class="rest-adjust-button" onclick="decreaseRest"><text class="rest-adjust-text">−15 秒</text></div>
          <div class="rest-adjust-button" onclick="increaseRest"><text class="rest-adjust-text">+15 秒</text></div>
        </div>

        <div class="next-card">
          <text class="next-eyebrow">下一组</text>
          <text class="next-name">{{ nextExerciseName }}</text>
          <text class="next-meta">{{ nextSetLabel }} · {{ nextPrescription }}</text>
        </div>

        <div class="action-row rest-actions">
          <div class="half-action rest-half-action dark-half-action" onclick="undoLastSet">
            <text class="half-action-text dark-half-action-text">撤销上一组</text>
          </div>
          <div class="half-action rest-half-action light-half-action" onclick="skipRest">
            <text class="half-action-text light-half-action-text">跳过休息</text>
          </div>
        </div>
      </div>

      <div else class="screen complete-screen">
        <div class="done-mark-box"><text class="done-mark">✓</text></div>
        <text class="done-title">训练完成</text>
        <text class="done-summary">共完成 {{ completedSets }} 组</text>
        <text class="done-note">{{ doneNote }}</text>

        <div class="action-row complete-actions">
          <div if="{{ canUndo }}" class="half-action complete-half-action dark-half-action" onclick="undoLastSet">
            <text class="half-action-text dark-half-action-text">撤销最后一组</text>
          </div>
          <div else class="half-spacer"></div>
          <div class="half-action complete-half-action light-half-action" onclick="restartWorkout">
            <text class="half-action-text light-half-action-text">重新开始</text>
          </div>
        </div>
      </div>
    </div>

    <div elif="{{ ready }}" class="restore-screen no-plan-screen">
      <text class="restore-brand">练了么</text>
      <text class="no-plan-title">暂无训练计划</text>
      <text class="restore-text">{{ connectionLabel }}</text>
      <text class="no-plan-hint">打开手机练了么后会自动获取当前计划</text>
      <div class="no-plan-action" onclick="requestPlan"><text class="no-plan-action-text">重新获取</text></div>
    </div>

    <div else class="restore-screen">
      <text class="restore-brand">练了么</text>
      <text class="restore-text">正在恢复训练状态</text>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import interconnect from '@system.interconnect'
import protocol from '../../common/workout-protocol.js'

var PLAN_KEY = 'lianleme.workout.plan.v1'
var STATE_KEY = 'lianleme.workout.state.v3'
var STATE_VERSION = 3
var APP_VERSION = '0.4.0'

var EMPTY_WORKOUT = {
  id: '',
  revision: '',
  planId: '',
  name: '',
  exercises: []
}

var WORKOUT = EMPTY_WORKOUT

function nowMs() {
  return new Date().getTime()
}

function numeric(value) {
  if (value === null || value === undefined || value === '') {
    return null
  }
  var result = Number(value)
  return isNaN(result) ? null : result
}

function formatWeight(value) {
  value = numeric(value)
  if (value === null) {
    return '自重'
  }
  if (value % 1 === 0) {
    return String(value)
  }
  return value.toFixed(1)
}

function formatPrescription(weight, reps) {
  var value = numeric(weight)
  if (value === null) {
    return reps + ' 次'
  }
  return formatWeight(value) + ' kg × ' + reps
}

function countSets() {
  var total = 0
  var exercises = WORKOUT && Array.isArray(WORKOUT.exercises) ? WORKOUT.exercises : []
  for (var i = 0; i < exercises.length; i++) {
    total += exercises[i].sets.length
  }
  return total
}

function validSetIndex(exerciseIndex, setIndex) {
  if (typeof exerciseIndex !== 'number' || typeof setIndex !== 'number') {
    return false
  }
  if (!WORKOUT || !Array.isArray(WORKOUT.exercises) || exerciseIndex < 0 || exerciseIndex >= WORKOUT.exercises.length) {
    return false
  }
  var exercise = WORKOUT.exercises[exerciseIndex]
  return setIndex >= 0 && setIndex < exercise.sets.length
}

function recordKey(exerciseIndex, setIndex) {
  return String(exerciseIndex) + ':' + String(setIndex)
}

export default {
  private: {
    ready: false,
    hasPlan: false,
    screen: 'workout',
    editing: false,
    editToggleText: '调整本组',
    exerciseIndex: 0,
    setIndex: 0,
    pendingExerciseIndex: 0,
    pendingSetIndex: 0,
    completedSets: 0,
    totalSets: 0,
    completedRecords: [],
    canUndo: false,
    currentExerciseName: '',
    currentSetLabel: '',
    currentRestSeconds: 0,
    currentWeight: null,
    currentReps: 0,
    weightText: '',
    repsText: '',
    prescription: '',
    workoutProgress: '',
    setProgress: '',
    nextHint: '',
    restRemaining: 0,
    restEndAt: 0,
    nextExerciseName: '',
    nextSetLabel: '',
    nextPrescription: '',
    restTimer: null,
    connectionReady: false,
    connectionDiagnosis: -1,
    connectionLabel: '离线',
    syncPending: false,
    progressUpdatedAt: 0,
    lastAckUpdatedAt: 0,
    doneNote: '记录保存在手环，连接后同步'
  },

  onInit() {
    this.restorePlan()
  },

  onShow() {
    if (!this.ready) {
      return
    }
    this.resumeFromLifecycle()
    if (this.connectionReady) {
      this.sendHelloAndProgress()
    } else {
      this.diagnoseConnection()
    }
  },

  onHide() {
    if (!this.ready) {
      return
    }
    this.stopRestTimer()
    if (this.hasPlan) {
      this.saveState()
    }
  },

  onDestroy() {
    if (!this.ready) {
      return
    }
    this.stopRestTimer()
    if (this.hasPlan) {
      this.saveState()
    }
  },

  restorePlan() {
    var that = this
    storage.get({
      key: PLAN_KEY,
      default: '',
      success: function(data) {
        WORKOUT = EMPTY_WORKOUT
        that.hasPlan = false
        if (data) {
          try {
            var plan = protocol.normalizePlan(JSON.parse(data))
            if (plan && plan.id && plan.revision) {
              WORKOUT = plan
              that.hasPlan = true
            }
          } catch (error) {
            console.log('Vela workout plan parse failed: ' + error)
          }
        }
        that.totalSets = countSets()
        that.restoreState()
      },
      fail: function(data, code) {
        console.log('Vela workout plan read failed: ' + code)
        WORKOUT = EMPTY_WORKOUT
        that.hasPlan = false
        that.totalSets = 0
        that.restoreState()
      }
    })
  },

  restoreState() {
    var that = this
    if (!this.hasPlan) {
      this.ready = true
      this.setupInterconnect()
      return
    }

    storage.get({
      key: STATE_KEY,
      default: '',
      success: function(data) {
        var restored = false
        if (data) {
          try {
            restored = that.applyStoredState(JSON.parse(data))
          } catch (error) {
            console.log('Vela workout state parse failed: ' + error)
          }
        }
        if (!restored) {
          that.resetWorkoutState(false)
        }
        that.ready = true
        that.resumeFromLifecycle()
        that.setupInterconnect()
      },
      fail: function(data, code) {
        console.log('Vela workout state read failed: ' + code)
        that.resetWorkoutState(false)
        that.ready = true
        that.resumeFromLifecycle()
        that.setupInterconnect()
      }
    })
  },

  applyStoredState(state) {
    if (!state || state.stateVersion !== STATE_VERSION || !this.hasPlan) {
      return false
    }
    if (String(state.workoutId || '') !== String(WORKOUT.id || '') ||
        String(state.revision || '') !== String(WORKOUT.revision || '')) {
      return false
    }
    if (!validSetIndex(state.exerciseIndex, state.setIndex)) {
      return false
    }

    this.stopRestTimer()
    this.screen = state.screen === 'rest' || state.screen === 'complete' ? state.screen : 'workout'
    this.exerciseIndex = state.exerciseIndex
    this.setIndex = state.setIndex
    this.pendingExerciseIndex = validSetIndex(state.pendingExerciseIndex, state.pendingSetIndex)
      ? state.pendingExerciseIndex
      : state.exerciseIndex
    this.pendingSetIndex = validSetIndex(state.pendingExerciseIndex, state.pendingSetIndex)
      ? state.pendingSetIndex
      : state.setIndex
    this.completedRecords = Array.isArray(state.completedRecords) ? state.completedRecords : []
    this.completedSets = this.completedRecords.length
    this.canUndo = this.completedSets > 0
    this.restEndAt = typeof state.restEndAt === 'number' ? state.restEndAt : 0
    this.progressUpdatedAt = Number(state.progressUpdatedAt || state.updatedAt) || nowMs()
    this.lastAckUpdatedAt = Number(state.lastAckUpdatedAt) || 0
    this.syncPending = typeof state.syncPending === 'boolean'
      ? state.syncPending
      : (this.completedRecords.length > 0 || this.screen === 'complete')
    this.editing = false
    this.editToggleText = '调整本组'

    var plannedSet = WORKOUT.exercises[this.exerciseIndex].sets[this.setIndex]
    this.currentWeight = state.currentWeight === null || typeof state.currentWeight === 'number'
      ? state.currentWeight
      : plannedSet.weight
    this.currentReps = typeof state.currentReps === 'number' ? state.currentReps : plannedSet.reps
    this.refreshCurrentDisplay()

    if (this.screen === 'rest') {
      if (!validSetIndex(this.pendingExerciseIndex, this.pendingSetIndex) || this.restEndAt <= 0) {
        return false
      }
      this.refreshRestPreview()
      this.syncRestRemaining()
    }
    this.refreshDoneNote()
    return true
  },

  currentStateSnapshot() {
    if (!this.hasPlan) {
      return null
    }
    return {
      stateVersion: STATE_VERSION,
      workoutId: String(WORKOUT.id || ''),
      revision: String(WORKOUT.revision || ''),
      screen: this.screen,
      exerciseIndex: this.exerciseIndex,
      setIndex: this.setIndex,
      pendingExerciseIndex: this.pendingExerciseIndex,
      pendingSetIndex: this.pendingSetIndex,
      currentWeight: this.currentWeight,
      currentReps: this.currentReps,
      completedRecords: this.completedRecords,
      restEndAt: this.restEndAt,
      updatedAt: this.progressUpdatedAt || nowMs(),
      progressUpdatedAt: this.progressUpdatedAt || nowMs(),
      syncPending: this.syncPending,
      lastAckUpdatedAt: this.lastAckUpdatedAt
    }
  },

  markProgressDirty() {
    this.progressUpdatedAt = nowMs()
    this.syncPending = true
    this.refreshDoneNote()
  },

  saveState() {
    var state = this.currentStateSnapshot()
    if (!state) {
      return null
    }
    storage.set({
      key: STATE_KEY,
      value: JSON.stringify(state),
      fail: function(data, code) {
        console.log('Vela workout state save failed: ' + code)
      }
    })
    return state
  },

  persistPlan() {
    if (!this.hasPlan) {
      return
    }
    storage.set({
      key: PLAN_KEY,
      value: JSON.stringify(WORKOUT),
      fail: function(data, code) {
        console.log('Vela workout plan save failed: ' + code)
      }
    })
  },

  resetWorkoutState(markDirty) {
    this.stopRestTimer()
    this.screen = 'workout'
    this.editing = false
    this.editToggleText = '调整本组'
    this.exerciseIndex = 0
    this.setIndex = 0
    this.pendingExerciseIndex = 0
    this.pendingSetIndex = 0
    this.completedRecords = []
    this.completedSets = 0
    this.totalSets = countSets()
    this.canUndo = false
    this.restRemaining = 0
    this.restEndAt = 0
    this.progressUpdatedAt = nowMs()
    this.syncPending = !!markDirty
    if (this.hasPlan && validSetIndex(0, 0)) {
      this.loadCurrentSet()
    }
    this.refreshDoneNote()
  },

  setupInterconnect() {
    var that = this
    var conn = interconnect.instance()
    this.conn = conn

    conn.onmessage = function(data) {
      that.handleIncomingMessage(data && data.data)
    }
    conn.onopen = function() {
      that.connectionReady = true
      that.connectionDiagnosis = 0
      that.refreshConnectionLabels()
      that.sendHelloAndProgress()
    }
    conn.onclose = function(data) {
      that.connectionReady = false
      that.connectionDiagnosis = data && typeof data.code === 'number' ? data.code : 1006
      that.refreshConnectionLabels()
    }
    conn.onerror = function(data) {
      that.connectionReady = false
      that.connectionDiagnosis = data && typeof data.code === 'number' ? data.code : 1000
      that.refreshConnectionLabels()
      console.log('Vela interconnect error: ' + (data && data.code))
      that.diagnoseConnection()
    }

    conn.getReadyState({
      success: function(data) {
        that.connectionReady = !!data && data.status === 1
        that.connectionDiagnosis = that.connectionReady ? 0 : 1006
        that.refreshConnectionLabels()
        if (that.connectionReady) {
          that.sendHelloAndProgress()
        } else {
          that.diagnoseConnection()
        }
      },
      fail: function(data, code) {
        that.connectionReady = false
        that.connectionDiagnosis = typeof code === 'number' ? code : 1000
        that.refreshConnectionLabels()
        console.log('Vela interconnect state failed: ' + code)
        that.diagnoseConnection()
      }
    })
  },

  diagnoseConnection() {
    var that = this
    if (!this.conn || typeof this.conn.diagnosis !== 'function') {
      return
    }
    this.conn.diagnosis({
      timeout: 4000,
      success: function(data) {
        var status = data && typeof data.status === 'number' ? data.status : 1000
        that.connectionDiagnosis = status
        that.connectionReady = status === 0
        that.refreshConnectionLabels()
        if (that.connectionReady) {
          that.sendHelloAndProgress()
        }
        console.log('Vela interconnect diagnosis: ' + status)
      },
      fail: function(data, code) {
        that.connectionReady = false
        that.connectionDiagnosis = typeof code === 'number' ? code : 1000
        that.refreshConnectionLabels()
        console.log('Vela interconnect diagnosis failed: ' + code)
      }
    })
  },

  refreshConnectionLabels() {
    if (this.connectionReady) {
      this.connectionLabel = '手机已连'
    } else if (this.connectionDiagnosis === 204) {
      this.connectionLabel = '连接超时'
    } else if (this.connectionDiagnosis === 1001) {
      this.connectionLabel = '手机未匹配'
    } else if (this.connectionDiagnosis === 1000) {
      this.connectionLabel = '互联异常'
    } else if (this.connectionDiagnosis === 1006) {
      this.connectionLabel = '连接断开'
    } else {
      this.connectionLabel = '离线'
    }
    this.refreshDoneNote()
  },

  refreshDoneNote() {
    if (!this.hasPlan) {
      this.doneNote = '等待手机同步训练计划'
    } else if (this.syncPending) {
      this.doneNote = this.connectionReady ? '正在同步训练记录' : '记录保存在手环，连接后同步'
    } else if (this.completedSets > 0 || this.screen === 'complete') {
      this.doneNote = '训练记录已同步到手机'
    } else {
      this.doneNote = this.connectionReady ? '手机已连接' : '可离线完成本次训练'
    }
  },

  sendEnvelope(type, payload) {
    if (!this.connectionReady || !this.conn) {
      return false
    }
    var message = protocol.envelope(type, payload)
    this.conn.send({
      data: message,
      fail: function(data, code) {
        console.log('Vela interconnect send failed: ' + code)
      }
    })
    return true
  },

  requestPlan() {
    if (!this.connectionReady) {
      this.diagnoseConnection()
      return
    }
    this.sendEnvelope('request-plan', {
      appVersion: APP_VERSION,
      planId: String(WORKOUT.planId || ''),
      workoutId: String(WORKOUT.id || ''),
      revision: String(WORKOUT.revision || '')
    })
  },

  sendHelloAndProgress() {
    if (!this.connectionReady) {
      return
    }
    this.sendEnvelope('hello', {
      appVersion: APP_VERSION,
      planId: String(WORKOUT.planId || ''),
      workoutId: String(WORKOUT.id || ''),
      revision: String(WORKOUT.revision || '')
    })
    this.requestPlan()
    if (this.hasPlan) {
      this.publishProgress()
    }
  },

  publishProgress() {
    if (!this.hasPlan || !WORKOUT.id || !WORKOUT.revision) {
      return false
    }
    var state = this.currentStateSnapshot()
    var sent = this.sendEnvelope('progress', protocol.progressPayload(WORKOUT, state))
    this.refreshDoneNote()
    return sent
  },

  handleIncomingMessage(raw) {
    var message = protocol.decode(raw)
    if (!message) {
      return
    }
    if (message.type === 'plan') {
      this.applyIncomingPlan(message.payload)
      return
    }
    if (message.type === 'progress') {
      this.applyIncomingProgress(message.payload)
      return
    }
    if (message.type === 'progress-ack') {
      this.applyProgressAck(message.payload)
    }
  },

  applyIncomingPlan(payload) {
    var plan = protocol.normalizePlan(payload)
    if (!plan || !plan.id || !plan.revision) {
      return
    }

    var same = this.hasPlan && protocol.samePlan(WORKOUT, plan)
    var activeLocalSession = this.hasPlan && this.completedRecords.length > 0 && this.screen !== 'complete'
    var unsyncedLocalSession = this.hasPlan && this.syncPending && WORKOUT.id && WORKOUT.revision
    if (!same && (activeLocalSession || unsyncedLocalSession)) {
      this.publishProgress()
      return
    }

    if (same) {
      if (this.syncPending) {
        this.publishProgress()
      }
      return
    }

    WORKOUT = plan
    this.hasPlan = true
    this.persistPlan()
    this.totalSets = countSets()
    this.resetWorkoutState(false)
    this.saveState()
    this.ready = true
    vibrator.vibrate({ mode: 'short' })
    this.sendEnvelope('ack', { workoutId: WORKOUT.id, revision: WORKOUT.revision })
  },

  applyIncomingProgress(payload) {
    if (!this.hasPlan) {
      return
    }
    var progress = protocol.normalizeProgress(payload)
    if (!progress || !protocol.progressMatchesPlan(progress, WORKOUT)) {
      return
    }

    if (this.syncPending) {
      this.publishProgress()
      return
    }

    var records = []
    var completed = {}
    for (var i = 0; i < progress.completedRecords.length; i++) {
      var record = progress.completedRecords[i]
      if (!validSetIndex(record.exerciseIndex, record.setIndex)) {
        continue
      }
      var key = recordKey(record.exerciseIndex, record.setIndex)
      if (completed[key]) {
        continue
      }
      completed[key] = true
      records.push(record)
    }

    var previousCompleted = this.completedRecords.length
    this.stopRestTimer()
    this.completedRecords = records
    this.completedSets = records.length
    this.canUndo = this.completedSets > 0
    this.progressUpdatedAt = progress.updatedAt || nowMs()
    this.lastAckUpdatedAt = this.progressUpdatedAt
    this.syncPending = false
    this.restEndAt = 0
    this.restRemaining = 0
    this.editing = false
    this.editToggleText = '调整本组'

    var next = this.firstIncompleteIndices(completed)
    if (progress.status === 'complete' || !next) {
      this.screen = 'complete'
      var lastExerciseIndex = Math.max(0, WORKOUT.exercises.length - 1)
      var lastSetIndex = Math.max(0, WORKOUT.exercises[lastExerciseIndex].sets.length - 1)
      this.exerciseIndex = lastExerciseIndex
      this.setIndex = lastSetIndex
      this.pendingExerciseIndex = lastExerciseIndex
      this.pendingSetIndex = lastSetIndex
      this.loadCurrentSet()
    } else {
      this.screen = 'workout'
      this.exerciseIndex = next.exerciseIndex
      this.setIndex = next.setIndex
      this.pendingExerciseIndex = next.exerciseIndex
      this.pendingSetIndex = next.setIndex
      this.loadCurrentSet()
    }

    this.saveState()
    this.refreshDoneNote()
    if (this.completedRecords.length !== previousCompleted) {
      vibrator.vibrate({ mode: 'short' })
    }
    this.sendEnvelope('progress-ack', {
      workoutId: String(WORKOUT.id || ''),
      revision: String(WORKOUT.revision || ''),
      planId: String(WORKOUT.planId || ''),
      updatedAt: this.progressUpdatedAt
    })
  },

  applyProgressAck(payload) {
    payload = payload || {}
    if (!this.hasPlan ||
        String(payload.workoutId || '') !== String(WORKOUT.id || '') ||
        String(payload.revision || '') !== String(WORKOUT.revision || '')) {
      return
    }
    var ackAt = Number(payload.updatedAt) || 0
    if (ackAt < Number(this.progressUpdatedAt || 0)) {
      return
    }
    this.syncPending = false
    this.lastAckUpdatedAt = ackAt
    this.saveState()
    this.refreshDoneNote()
  },

  firstIncompleteIndices(completed) {
    for (var exerciseIndex = 0; exerciseIndex < WORKOUT.exercises.length; exerciseIndex++) {
      var exercise = WORKOUT.exercises[exerciseIndex]
      for (var setIndex = 0; setIndex < exercise.sets.length; setIndex++) {
        if (!completed[recordKey(exerciseIndex, setIndex)]) {
          return { exerciseIndex: exerciseIndex, setIndex: setIndex }
        }
      }
    }
    return null
  },

  resumeFromLifecycle() {
    if (!this.hasPlan || this.screen !== 'rest') {
      return
    }
    this.syncRestRemaining()
    if (this.restRemaining <= 0) {
      this.finishRest(true)
      return
    }
    this.startRestTimer()
  },

  loadCurrentSet(weightOverride, repsOverride) {
    if (!this.hasPlan || !validSetIndex(this.exerciseIndex, this.setIndex)) {
      return
    }
    var set = WORKOUT.exercises[this.exerciseIndex].sets[this.setIndex]
    this.currentWeight = weightOverride === null || typeof weightOverride === 'number' ? weightOverride : set.weight
    this.currentReps = typeof repsOverride === 'number' ? repsOverride : set.reps
    this.refreshCurrentDisplay()
  },

  refreshCurrentDisplay() {
    if (!this.hasPlan || !validSetIndex(this.exerciseIndex, this.setIndex)) {
      return
    }
    var exercise = WORKOUT.exercises[this.exerciseIndex]
    this.currentExerciseName = exercise.name
    this.currentSetLabel = '第 ' + (this.setIndex + 1) + ' / ' + exercise.sets.length + ' 组'
    this.currentRestSeconds = exercise.restSeconds
    this.workoutProgress = WORKOUT.name + ' · 动作 ' + (this.exerciseIndex + 1) + ' / ' + WORKOUT.exercises.length
    this.setProgress = this.completedSets + ' / ' + this.totalSets
    this.updatePrescription()
    this.updateNextHint()
  },

  updatePrescription() {
    this.weightText = numeric(this.currentWeight) === null ? '自重' : formatWeight(this.currentWeight) + ' kg'
    this.repsText = this.currentReps + ' 次'
    this.prescription = formatPrescription(this.currentWeight, this.currentReps)
  },

  updateNextHint() {
    var next = this.getNextIndices()
    if (!next) {
      this.nextHint = '完成训练'
      return
    }
    if (next.exerciseIndex === this.exerciseIndex) {
      this.nextHint = '第 ' + (next.setIndex + 1) + ' 组'
    } else {
      this.nextHint = WORKOUT.exercises[next.exerciseIndex].name
    }
  },

  getNextIndices() {
    if (!this.hasPlan || !validSetIndex(this.exerciseIndex, this.setIndex)) {
      return null
    }
    var exercise = WORKOUT.exercises[this.exerciseIndex]
    if (this.setIndex + 1 < exercise.sets.length) {
      return { exerciseIndex: this.exerciseIndex, setIndex: this.setIndex + 1 }
    }
    if (this.exerciseIndex + 1 < WORKOUT.exercises.length) {
      return { exerciseIndex: this.exerciseIndex + 1, setIndex: 0 }
    }
    return null
  },

  toggleEdit() {
    this.editing = !this.editing
    this.editToggleText = this.editing ? '收起调整' : '调整本组'
  },

  decreaseWeight() {
    if (numeric(this.currentWeight) === null || this.currentWeight <= 2.5) {
      return
    }
    this.currentWeight = this.currentWeight - 2.5
    this.updatePrescription()
    this.saveState()
  },

  increaseWeight() {
    if (numeric(this.currentWeight) === null) {
      return
    }
    this.currentWeight = this.currentWeight + 2.5
    this.updatePrescription()
    this.saveState()
  },

  decreaseReps() {
    if (this.currentReps <= 1) {
      return
    }
    this.currentReps = this.currentReps - 1
    this.updatePrescription()
    this.saveState()
  },

  increaseReps() {
    this.currentReps = this.currentReps + 1
    this.updatePrescription()
    this.saveState()
  },

  completeSet() {
    if (!this.hasPlan || this.screen !== 'workout') {
      return
    }

    var exercise = WORKOUT.exercises[this.exerciseIndex]
    var plannedSet = exercise.sets[this.setIndex]
    var next = this.getNextIndices()
    var record = {
      exerciseIndex: this.exerciseIndex,
      setIndex: this.setIndex,
      plannedWeight: plannedSet.weight,
      plannedReps: plannedSet.reps,
      actualWeight: this.currentWeight,
      actualReps: this.currentReps,
      completedAt: nowMs()
    }

    this.editing = false
    this.editToggleText = '调整本组'
    this.completedRecords.push(record)
    this.completedRecords = this.completedRecords.slice(0)
    this.completedSets = this.completedRecords.length
    this.canUndo = true
    this.setProgress = this.completedSets + ' / ' + this.totalSets
    this.markProgressDirty()
    vibrator.vibrate({ mode: 'short' })

    if (!next) {
      this.finishWorkout()
      return
    }

    this.pendingExerciseIndex = next.exerciseIndex
    this.pendingSetIndex = next.setIndex
    this.prepareRestScreen()
    this.screen = 'rest'
    this.saveState()
    this.publishProgress()
    this.startRestTimer()
  },

  prepareRestScreen() {
    var currentExercise = WORKOUT.exercises[this.exerciseIndex]
    this.restEndAt = nowMs() + currentExercise.restSeconds * 1000
    this.refreshRestPreview()
    this.syncRestRemaining()
  },

  refreshRestPreview() {
    if (!validSetIndex(this.pendingExerciseIndex, this.pendingSetIndex)) {
      return
    }
    var nextExercise = WORKOUT.exercises[this.pendingExerciseIndex]
    var nextSet = nextExercise.sets[this.pendingSetIndex]
    this.nextExerciseName = nextExercise.name
    this.nextSetLabel = '第 ' + (this.pendingSetIndex + 1) + ' / ' + nextExercise.sets.length + ' 组'
    this.nextPrescription = formatPrescription(nextSet.weight, nextSet.reps)
  },

  syncRestRemaining() {
    var remainingMs = this.restEndAt - nowMs()
    if (remainingMs <= 0) {
      this.restRemaining = 0
      return
    }
    this.restRemaining = Math.ceil(remainingMs / 1000)
  },

  startRestTimer() {
    this.stopRestTimer()
    this.syncRestRemaining()
    if (this.restRemaining <= 0) {
      this.finishRest(true)
      return
    }
    var that = this
    this.restTimer = setInterval(function() {
      that.syncRestRemaining()
      if (that.restRemaining <= 0) {
        that.finishRest(true)
      }
    }, 1000)
  },

  stopRestTimer() {
    if (this.restTimer !== null) {
      clearInterval(this.restTimer)
      this.restTimer = null
    }
  },

  decreaseRest() {
    this.adjustRest(-15)
  },

  increaseRest() {
    this.adjustRest(15)
  },

  adjustRest(deltaSeconds) {
    if (this.screen !== 'rest') {
      return
    }
    var minimumEnd = nowMs() + 5000
    var nextEnd = this.restEndAt + deltaSeconds * 1000
    this.restEndAt = nextEnd < minimumEnd ? minimumEnd : nextEnd
    this.syncRestRemaining()
    this.saveState()
  },

  skipRest() {
    if (this.screen !== 'rest') {
      return
    }
    this.finishRest(false)
  },

  finishRest(naturalEnd) {
    if (this.screen !== 'rest') {
      return
    }
    this.stopRestTimer()
    if (naturalEnd) {
      vibrator.vibrate({ mode: 'long' })
    }
    this.exerciseIndex = this.pendingExerciseIndex
    this.setIndex = this.pendingSetIndex
    this.restEndAt = 0
    this.restRemaining = 0
    this.screen = 'workout'
    this.loadCurrentSet()
    this.saveState()
  },

  undoLastSet() {
    if (!this.completedRecords.length) {
      return
    }

    this.stopRestTimer()
    var record = this.completedRecords[this.completedRecords.length - 1]
    this.completedRecords = this.completedRecords.slice(0, this.completedRecords.length - 1)
    this.completedSets = this.completedRecords.length
    this.canUndo = this.completedSets > 0
    this.screen = 'workout'
    this.editing = false
    this.editToggleText = '调整本组'
    this.exerciseIndex = record.exerciseIndex
    this.setIndex = record.setIndex
    this.pendingExerciseIndex = record.exerciseIndex
    this.pendingSetIndex = record.setIndex
    this.restEndAt = 0
    this.restRemaining = 0
    this.loadCurrentSet(record.actualWeight, record.actualReps)
    this.markProgressDirty()
    vibrator.vibrate({ mode: 'short' })
    this.saveState()
    this.publishProgress()
  },

  finishWorkout() {
    this.stopRestTimer()
    this.restEndAt = 0
    this.restRemaining = 0
    this.screen = 'complete'
    this.markProgressDirty()
    this.saveState()
    this.publishProgress()
    vibrator.vibrate({ mode: 'long' })
  },

  restartWorkout() {
    this.resetWorkoutState(true)
    this.saveState()
    this.publishProgress()
  }
}
</script>

<style>
@import '../../common/workout.css';

.no-plan-screen {
  padding-left: 30px;
  padding-right: 30px;
}

.no-plan-title {
  margin-top: 28px;
  font-size: 28px;
  font-weight: 700;
  color: #111827;
}

.no-plan-hint {
  margin-top: 12px;
  font-size: 16px;
  line-height: 24px;
  color: #6b7280;
  text-align: center;
}

.no-plan-action {
  margin-top: 28px;
  width: 184px;
  height: 52px;
  border-radius: 18px;
  background-color: #111827;
  justify-content: center;
  align-items: center;
}

.no-plan-action-text {
  color: #ffffff;
  font-size: 18px;
  font-weight: 600;
}
</style>
